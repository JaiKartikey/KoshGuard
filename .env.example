# Copy to .env and fill in what you need:  Copy-Item .env.example .env
# Every value is optional. With no GROQ_API_KEY, KoshGuard runs fully offline
# against a deterministic mock LLM (this is what tests and CI use).

# --- LLM ------------------------------------------------------------------
GROQ_API_KEY=
# auto = use Groq if GROQ_API_KEY is set, otherwise mock. Force with mock | groq.
LLM_MODE=auto
PRIMARY_MODEL=llama-3.3-70b-versatile
FALLBACK_MODEL=llama-3.1-8b-instant

# --- Gateway --------------------------------------------------------------
MAX_RETRIES=2
BREAKER_FAILURE_THRESHOLD=5
BREAKER_RESET_SECONDS=30
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SECOND=0.5
DAILY_TOKEN_BUDGET=50000
CACHE_TTL_SECONDS=3600
# REDIS_URL=redis://localhost:6379/0

# --- Guardrails -----------------------------------------------------------
INJECTION_BLOCK_THRESHOLD=0.6
GROUNDING_MIN_OVERLAP=0.5

# --- Observability --------------------------------------------------------
AUDIT_LOG_PATH=logs/audit.jsonl
# Set to make the audit chain keyed (HMAC); without it a plain SHA-256 chain is used.
AUDIT_HMAC_KEY=
LOG_LEVEL=INFO
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=koshguard
# LOGFIRE_TOKEN=
